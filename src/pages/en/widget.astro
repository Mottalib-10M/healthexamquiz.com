---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/cna-practice/" title="CNA practice quiz" width="100%" height="860" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/pharmacy-days-supply/" title="Days supply calculator" width="100%" height="520" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed a free CNA quiz or pharmacy calculator on your site" description="Show the free CNA practice quiz or the days supply calculator on a school, library or workforce site: one iframe, no sign-up, no tracking, no cost, kept up to date." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a quiz or a calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For libraries, adult education centers, workforce boards and student clubs that help people into health care jobs.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>CNA written exam practice</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>Pharmacy days supply</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <p>Conditions: keep the credit line under the frame visible and use the tool as it is, without warranty. The frame updates itself when a format or a fee changes. Nothing your visitors type reaches us, and the frame sets no cookie. Each frame states that the site is independent of the certifying bodies. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/cna-practice/" title="CNA practice quiz" width="100%" height="860" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
